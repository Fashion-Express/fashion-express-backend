# Application
NODE_ENV=development
PORT=3000

# Database (NFR-16 — PostgreSQL is the database of record)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fashion_express
DATABASE_URL_TEST=postgresql://postgres:yourpassword@localhost:5432/fashion_express_test

# NFR-07 — TLS on the database link. 'auto' (the default) encrypts every
# non-loopback connection and leaves a local database alone; 'require' and
# 'disable' force it either way.
DATABASE_SSL=auto
# Optional: the CA that signed the server certificate, as a file path or an
# inline PEM. Managed providers sign with a private root, so without this the
# link is encrypted but the server identity is not verified. Supabase publishes
# its root under Settings -> Database -> SSL configuration.
# DATABASE_SSL_CA=./certs/prod-ca-2021.crt

# Authentication (better-auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Login protection (FR-00.9, FR-00.10)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=60

# FR-10.3 data cleanup (BR-42 — off unless deliberately enabled)
ENABLE_DATA_CLEANUP=false
